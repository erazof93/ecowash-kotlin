generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model clientes {
  usuario_id            String    @id @db.Uuid
  calificacion_promedio Decimal?  @default(5.00) @db.Decimal(3, 2)
  usuarios              usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cliente_usuario")
  pedidos               pedidos[]
}

model historial_cartera {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lavador_id       String    @db.Uuid
  pedido_id        String?   @db.Uuid
  tipo_movimiento  String    @db.VarChar(50)
  monto            Decimal   @db.Decimal(10, 2)
  saldo_resultante Decimal   @db.Decimal(12, 2)
  creado_at        DateTime? @default(now()) @db.Timestamptz(6)
  lavadores        lavadores @relation(fields: [lavador_id], references: [usuario_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_historial_lavador")
  pedidos          pedidos?  @relation(fields: [pedido_id], references: [id], onUpdate: NoAction, map: "fk_historial_pedido")

  @@index([lavador_id], map: "idx_historial_cartera_lavador")
}

model lavadores {
  usuario_id            String                 @id @db.Uuid
  saldo_cartera         Decimal                @default(0.00) @db.Decimal(12, 2)
  esta_disponible       Boolean                @default(false)
  esta_verificado       Boolean                @default(false)
  calificacion_promedio Decimal?               @default(5.00) @db.Decimal(3, 2)
  historial_cartera     historial_cartera[]
  usuarios              usuarios               @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_lavador_usuario")
  pedidos               pedidos[]
  ubicaciones_lavadores ubicaciones_lavadores?
}

model pedidos {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cliente_id         String                  @db.Uuid
  lavador_id         String?                 @db.Uuid
  estado             estado_pedido_enum      @default(PENDIENTE)
  ubicacion_cliente  Unsupported("geometry")
  direccion_texto    String
  precio_total       Decimal                 @db.Decimal(10, 2)
  comision_calculada Decimal                 @db.Decimal(10, 2)
  lavado_iniciado_at DateTime?               @db.Timestamptz(6)
  creado_at          DateTime?               @default(now()) @db.Timestamptz(6)
  actualizado_at     DateTime?               @default(now()) @db.Timestamptz(6)
  historial_cartera  historial_cartera[]
  clientes           clientes                @relation(fields: [cliente_id], references: [usuario_id], onUpdate: NoAction, map: "fk_pedido_cliente")
  lavadores          lavadores?              @relation(fields: [lavador_id], references: [usuario_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_pedido_lavador")

  @@index([cliente_id], map: "idx_pedidos_cliente")
  @@index([estado], map: "idx_pedidos_estado")
  @@index([ubicacion_cliente], map: "idx_pedidos_geom", type: Gist)
  @@index([lavador_id], map: "idx_pedidos_lavador")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model ubicaciones_lavadores {
  lavador_id           String                  @id @db.Uuid
  coordenada           Unsupported("geometry")
  ultima_actualizacion DateTime?               @default(now()) @db.Timestamptz(6)
  lavadores            lavadores               @relation(fields: [lavador_id], references: [usuario_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ubicacion_lavador")

  @@index([coordenada], map: "idx_ubicaciones_lavadores_geom", type: Gist)
}

model usuarios {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correo          String     @unique @db.VarChar(255)
  contrasena_hash String?    @db.VarChar(255)
  google_id       String?    @unique @db.VarChar(255)
  nombre_completo String     @db.VarChar(150)
  telefono        String?    @db.VarChar(20)
  foto_url        String?
  creado_at       DateTime?  @default(now()) @db.Timestamptz(6)
  actualizado_at  DateTime?  @default(now()) @db.Timestamptz(6)
  clientes        clientes?
  lavadores       lavadores?
}

enum estado_pedido_enum {
  PENDIENTE
  ACEPTADO
  EN_CAMINO
  EN_SITIO
  LAVANDO
  FINALIZADO
  CANCELADO
}
